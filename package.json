{
  "name": "mono-finance",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/run-vite-development.mjs",
    "build": "tsc -b && node scripts/build-production.mjs",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "audit:dependencies": "npm audit --audit-level=high",
    "security:client-bundle": "node scripts/verify-client-bundle.mjs",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "npm run build && vite preview",
    "deploy": "npm run deploy:production",
    "deploy:production": "wrangler deploy --config dist/mono_finance/wrangler.production.json",
    "prepare:production": "node scripts/prepare-production-deployment.mjs",
    "release:production": "npm run build && npm run prepare:production && npm run db:migrate:production && npm run deploy:production && npm run healthcheck:production",
    "healthcheck:production": "node scripts/check-production-health.mjs",
    "cf-typegen": "wrangler types --env development",
    "db:create": "wrangler d1 create",
    "db:migrations:local": "wrangler d1 migrations list DB --env development --local --persist-to .wrangler/state",
    "db:migrate:local": "wrangler d1 migrations apply DB --env development --local --persist-to .wrangler/state",
    "db:migrate:remote": "wrangler d1 migrations apply",
    "db:migrate:production": "wrangler d1 migrations apply DB --remote --config dist/mono_finance/wrangler.production.json",
    "db:execute:local": "wrangler d1 execute DB --env development --local --persist-to .wrangler/state"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.102.8",
    "hono": "^4.13.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.6",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.9.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0",
    "wrangler": "^4.130.0"
  },
  "overrides": {
    "sharp": "0.35.4"
  }
}
